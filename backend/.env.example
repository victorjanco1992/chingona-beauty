# Neon: cadena "pooled" (host con -pooler) para la app
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon: cadena directa (sin -pooler) para db push / migraciones
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST.neon.tech/neondb?sslmode=require"

# Secreto largo y aleatorio para firmar sesiones del panel
JWT_SECRET=""

# URL(s) del frontend en Render, separadas por coma
CORS_ORIGIN="https://tu-frontend.onrender.com"

# Número de WhatsApp por defecto (formato internacional sin + ni espacios). También editable desde el panel.
WHATSAPP_NUMBER=""

# Solo para el script de creación del administrador (npm run seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
